[importlinter]
root_packages =
    interpreter
    cobol_asg
    cobol_memory
    cobol_numeric
    hlasm_asg
    zarch_float
    infrastructure

# The reason cobol_asg is a sibling of interpreter rather than a subpackage of
# it: an import of interpreter.anything runs interpreter/__init__.py, which
# loads the VM. A consumer that only reads COBOL -- cobble's knowledge-graph
# extractor -- imports cobol_asg and nothing else, so this contract is what
# keeps that promise true. cobol_asg parses; interpreter.cobol lowers.
# cobol_memory holds storage algebra rather than ASG nodes, and it is a sibling
# for the same reason -- a consumer that only computes byte ranges must not
# load the VM.
[importlinter:contract:cobol-asg-is-a-leaf]
name = The COBOL ASG surface must not import the interpreter
type = forbidden
source_modules =
    cobol_asg
forbidden_modules =
    interpreter

[importlinter:contract:hlasm-asg-is-a-leaf]
name = The HLASM ASG surface must not import the interpreter
type = forbidden
source_modules =
    hlasm_asg
forbidden_modules =
    interpreter

[importlinter:contract:cobol-memory-is-a-leaf]
name = The byte-extent algebra must not import the interpreter
type = forbidden
source_modules =
    cobol_memory
forbidden_modules =
    interpreter

[importlinter:contract:cobol-numeric-is-a-leaf]
name = The COBOL numeric boundary must not import the interpreter
type = forbidden
source_modules =
    cobol_numeric
forbidden_modules =
    interpreter

[importlinter:contract:zarch-float-is-a-leaf]
name = The z/Architecture floating-point arithmetic must not import the interpreter
type = forbidden
source_modules =
    zarch_float
forbidden_modules =
    interpreter

[importlinter:contract:infrastructure-is-below-interpreter]
name = infrastructure never imports interpreter, so importing it never loads the VM
type = forbidden
source_modules =
    infrastructure
forbidden_modules =
    interpreter

[importlinter:contract:vm-no-frontend]
name = VM must not import frontend lowering code
type = forbidden
source_modules =
    interpreter.vm
    interpreter.handlers
forbidden_modules =
    interpreter.frontends
ignore_imports =
    interpreter.vm.executor -> interpreter.frontends.symbol_table

[importlinter:contract:ir-is-leaf]
name = IR module must not import other interpreter modules
type = forbidden
source_modules =
    interpreter.ir
forbidden_modules =
    interpreter.vm
    interpreter.handlers
    interpreter.cfg
    interpreter.frontends
    interpreter.run
    interpreter.llm

[importlinter:contract:project-no-vm-internals]
name = Project module must not import VM internals
type = forbidden
source_modules =
    interpreter.project
forbidden_modules =
    interpreter.vm
    interpreter.handlers

[importlinter:contract:frontend-independence]
name = Language frontends must not import each other
type = independence
modules =
    interpreter.frontends.python
    interpreter.frontends.java
    interpreter.frontends.go
    interpreter.frontends.rust
    interpreter.frontends.csharp
    interpreter.frontends.kotlin
    interpreter.frontends.scala
    interpreter.frontends.ruby
    interpreter.frontends.php
    interpreter.frontends.lua
    interpreter.frontends.pascal
ignore_imports =
    interpreter.frontends.cpp.frontend -> interpreter.frontends.c.frontend
    interpreter.frontends.cpp.expressions -> interpreter.frontends.c.expressions
    interpreter.frontends.cpp.expressions -> interpreter.frontends.c.declarations
    interpreter.frontends.cpp.control_flow -> interpreter.frontends.c.declarations
    interpreter.frontends.cpp.declarations -> interpreter.frontends.c.declarations
    interpreter.frontends.c.declarations -> interpreter.frontends.cpp.node_types
    interpreter.frontends.c.declarations -> interpreter.frontends.cpp.control_flow

[importlinter:contract:cobol-isolation]
name = COBOL module only imported by frontend factory
type = forbidden
source_modules =
    interpreter.vm
    interpreter.handlers
    interpreter.project
    interpreter.run
forbidden_modules =
    interpreter.cobol
# Three exceptions used to live here -- interpreter.frontend reaching for
# cobol_parser and subprocess_runner, and project.cobol_compile for ast_store.
# They existed only because parsing and lowering shared interpreter.cobol; the
# parsing half is cobol_asg now, which this contract does not police.
ignore_imports =
    interpreter.vm.builtins -> interpreter.cobol.byte_builtins
    interpreter.frontends -> interpreter.cobol.cobol_frontend
    interpreter.frontend_extension_lowering -> interpreter.cobol.emit_context
    interpreter.frontend_extension_lowering -> interpreter.cobol.sectioned_layout

[importlinter:contract:hlasm-isolation]
name = HLASM module only imported by frontend factory
type = forbidden
source_modules =
    interpreter.vm
    interpreter.handlers
    interpreter.project
    interpreter.run
forbidden_modules =
    interpreter.hlasm
ignore_imports =
    interpreter.frontends -> interpreter.hlasm.hlasm_frontend

[importlinter:contract:hlasm-not-cobol]
name = HLASM lowering must not import COBOL lowering directly
type = forbidden
source_modules =
    interpreter.hlasm
forbidden_modules =
    interpreter.cobol
allow_indirect_imports = True

[importlinter:contract:cobol-not-hlasm]
name = COBOL lowering must not import HLASM lowering directly
type = forbidden
source_modules =
    interpreter.cobol
forbidden_modules =
    interpreter.hlasm
allow_indirect_imports = True

[importlinter:contract:record-io-is-neutral]
name = Record I/O must not import a language's lowering
type = forbidden
source_modules =
    interpreter.record_io
    infrastructure.zos.access_methods
forbidden_modules =
    interpreter.cobol
    interpreter.hlasm
