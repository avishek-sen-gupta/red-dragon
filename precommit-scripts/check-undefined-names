#!/bin/bash
# Blocking gate on pyright's reportUndefinedVariable.
#
# An annotation may name something that does not exist at runtime and nothing
# will notice: `from __future__ import annotations` keeps annotations as strings,
# so the name is never looked up, the module imports, and the whole test suite
# passes. It surfaces only when something calls typing.get_type_hints() -- which
# interpreter/api.py, interpreter/instructions.py, interpreter/ir.py,
# interpreter/vm/vm_types.py and mcp_server/tools.py all do.
#
# That is how `from typing import TYPE_CHECKING, Optional` lost its Optional in
# d3bf97ea while `-> Optional[Node]` stayed at api.py:295. Tests could not catch
# it. Pyright reported it immediately, but the pyright hook is `|| true` over
# hundreds of pre-existing errors (red-dragon-bqgc), so nothing failed.
#
# This gate is narrow on purpose: ONE rule, which stands at zero today, so it can
# block without a ratchet. The broad pyright run stays advisory next to it.
#
# Exit 0 = no undefined names, exit 1 = blocked.

set -uo pipefail

OUT=$(uv run pyright --outputjson 2>/dev/null)
if [ -z "$OUT" ]; then
  echo "check-undefined-names: pyright produced no output; not blocking" >&2
  exit 0
fi

printf '%s' "$OUT" | python3 -c '
import json, sys

try:
    diagnostics = json.load(sys.stdin)["generalDiagnostics"]
except Exception as exc:  # malformed output must not silently pass
    print(f"check-undefined-names: could not parse pyright output: {exc}", file=sys.stderr)
    raise SystemExit(1)

undefined = [
    d for d in diagnostics
    if d.get("rule") == "reportUndefinedVariable" and d.get("severity") == "error"
]
for d in undefined:
    path = d["file"].split("red-dragon/")[-1]
    line = d["range"]["start"]["line"] + 1
    msg = d["message"].splitlines()[0]
    print(f"  {path}:{line}  {msg}")

if undefined:
    print(f"\n{len(undefined)} undefined name(s) in annotations or code.")
    print("An annotation naming something unimportable passes every test: lazy")
    print("annotations are never evaluated. It breaks typing.get_type_hints().")
    print("Import the name, or move it into the `if TYPE_CHECKING:` block.")
    raise SystemExit(1)
'
