{
  "lint_rules_dir": ".python-fp-lint",
  "baseline": "fp-baseline.json",
  "exclude": [],
  "exclude_why": {
    "_": "Read by nobody: JSON has no comments, and an exclusion whose reason lives in another file is one nobody can judge later. Every key in `exclude` appears here. Empty is the goal -- the ratchet (see `baseline`) is how a pre-existing backlog stops blocking commits, so unblocking is no longer a reason to exclude a file. Exclude only code the rules genuinely do not apply to, and say why here."
  },
  "ruff_select": "E,F,W,I,B,UP,SIM,RUF,BLE,T20,TID252,C901,PLR0915,ANN401",
  "max_complexity": 3,
  "max_statements": 10,
  "ast_grep_rules": [
    "no-list-append",
    "no-list-extend",
    "no-list-insert",
    "no-list-pop",
    "no-list-remove",
    "no-dict-clear",
    "no-dict-update",
    "no-dict-setdefault",
    "no-set-add",
    "no-set-discard",
    "no-subscript-mutation",
    "no-subscript-del",
    "no-subscript-augmented-mutation",
    "no-subscript-tuple-mutation",
    "no-setitem-call",
    "no-local-augmented-mutation",
    "no-attribute-augmented-mutation",
    "no-is-none",
    "no-is-not-none",
    "no-optional-none",
    "no-none-default-param",
    "no-static-method",
    "no-deep-nesting",
    "no-loop-mutation",
    "no-list-dict-param-annotation",
    "no-unfrozen-dataclass",
    "no-any-type"
  ]
}
