         MACRO
&NAME    RDPLIST &LIST,&VL,&INLINE
         LCLA  &I,&N
         LCLC  &HIGH,&LABEL
&N       SETA  N'&LIST
&LABEL   SETC  '&NAME'
         AIF   ('&INLINE' NE 'INLINE').NEXT
&NAME    BRAS  1,RDP&SYSNDX
&LABEL   SETC  ''
.NEXT    ANOP
&I       SETA  &I+1
&HIGH    SETC  ''
         AIF   (&I LT &N OR '&VL' EQ '').WORD
&HIGH    SETC  'X''80000000''+'
.WORD    ANOP
&LABEL   DC    A(&HIGH&LIST(&I))
&LABEL   SETC  ''
         AIF   (&I LT &N).NEXT
         AIF   ('&INLINE' NE 'INLINE').DONE
RDP&SYSNDX DS  0H
.DONE    MEND
