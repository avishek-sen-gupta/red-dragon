         MACRO
&NAME    SAVE  &REGS,&T,&ID
         GBLA  &RDRV
         LCLA  &R1,&R2,&LEN,&OFF
         LCLC  &TEXT,&LABEL
         AIF   (N'&REGS GT 0 AND N'&REGS LE 2).HAVE
         MNOTE 8,'SAVE: REGISTER RANGE MISSING OR TOO LONG'
         MEXIT
.HAVE    ANOP
         RDREGN &REGS(1)
&R1      SETA  &RDRV
&R2      SETA  &RDRV
         AIF   (N'&REGS LT 2).CHECK
         RDREGN &REGS(2)
&R2      SETA  &RDRV
.CHECK   AIF   (&R1 LT 0 OR &R2 LT 0).BADREG
         AIF   ('&T' EQ '' OR '&T' EQ 'T').TOK
         MNOTE 8,'SAVE: SECOND OPERAND MUST BE T'
         MEXIT
.TOK     ANOP
&LABEL   SETC  '&NAME'
&OFF     SETA  (&R1*4+20)-((&R1*4+20)/64)*64
         AIF   ('&ID' EQ '').STORE
&TEXT    SETC  '&ID'
         AIF   ('&ID' NE '*').SIZE
&TEXT    SETC  '&SYSECT'
         AIF   ('&NAME' EQ '').SIZE
&TEXT    SETC  '&NAME'
.SIZE    ANOP
&LEN     SETA  K'&TEXT
         AIF   (&LEN GT 70).LONG
&NAME    J     RDB&SYSNDX
         DC    AL1(&LEN),CL&LEN'&TEXT'
RDB&SYSNDX DS  0H
&LABEL   SETC  ''
.STORE   ANOP
&LABEL   STM   &R1,&R2,&OFF.(13)
         AIF   ('&T' NE 'T' OR &R1 EQ 14).DONE
         STM   14,15,12(13)
.DONE    MEXIT
.BADREG  MNOTE 8,'SAVE: INVALID REGISTER'
         MEXIT
.LONG    MNOTE 8,'SAVE: IDENTIFIER LONGER THAN 70 CHARACTERS'
         MEND
