         MACRO
         RDSTSVC &LV,&SP,&FLAGS
         RDSTLEN &LV
         AIF   ('&SP' NE '').SP
         IILF  15,&FLAGS
         AGO   .SVC
.SP      AIF   ('&SP'(1,1) EQ '(').SPREG
         IILF  15,(&SP)*256+&FLAGS
         AGO   .SVC
.SPREG   LLCR  15,&SP(1)
         SLL   15,8
         OILL  15,&FLAGS
.SVC     SVC   120
         MEND
