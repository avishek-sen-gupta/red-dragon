         MACRO
         RDPGM &OWNER,&EP,&EPLOC,&LIST
         GBLA  &RDRV
         GBLB  &RDSTBAD
&RDSTBAD SETB  1
         AIF   ('&EP' NE '' AND '&EPLOC' NE '').BOTH
         AIF   ('&EP' NE '').EP
         AIF   ('&EPLOC' NE '').EPLOC
         MNOTE 8,'&OWNER: EP OR EPLOC MISSING'
         MEXIT
.BOTH    MNOTE 8,'&OWNER: EP AND EPLOC BOTH GIVEN'
         MEXIT
.EP      AIF   (K'&EP GT 8).LONG
&RDSTBAD SETB  0
         AIF   ('&LIST' EQ 'LIST').EPLIST
         BRAS  0,RDN&SYSNDX
         DC    CL8'&EP'
RDN&SYSNDX DS  0H
         MEXIT
.EPLIST  BRAS  15,RDN&SYSNDX
         DC    AL4(RDE&SYSNDX,0)
RDE&SYSNDX DC  CL8'&EP'
RDN&SYSNDX DS  0H
         MEXIT
.LONG    MNOTE 8,'&OWNER: EP LONGER THAN 8 CHARACTERS'
         MEXIT
.EPLOC   AIF   ('&EPLOC'(1,1) EQ '(').REG
&RDSTBAD SETB  0
         AIF   ('&LIST' EQ 'LIST').ADDRLST
         LA    0,&EPLOC
         MEXIT
.ADDRLST BRAS  15,RDN&SYSNDX
         DC    AL4(&EPLOC,0)
RDN&SYSNDX DS  0H
         MEXIT
.REG     RDREGN &EPLOC(1)
         AIF   (&RDRV GE 2 AND &RDRV LE 12).REGOK
         MNOTE 8,'&OWNER: EPLOC REGISTER MUST BE 2 TO 12'
         MEXIT
.REGOK   ANOP
&RDSTBAD SETB  0
         AIF   ('&LIST' EQ 'LIST').REGLIST
         LR    0,&RDRV
         MEXIT
.REGLIST BRAS  15,RDN&SYSNDX
         DC    AL4(0,0)
RDN&SYSNDX ST  &RDRV,0(,15)
         MEND
