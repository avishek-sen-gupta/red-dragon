         MACRO
&NAME    RETURN &REGS,&T,&RC=
         GBLA  &RDRV
         LCLA  &R1,&R2,&OFF,&LOW
         LCLB  &SKIP15
         LCLC  &RCV
&RCV     SETC  '&RC'
         AIF   ('&RC' NE '(R15)').CHECKT
&RCV     SETC  '(15)'
.CHECKT  AIF   ('&T' EQ '' OR '&T' EQ 'T').CHECKRC
         MNOTE 8,'RETURN: SECOND OPERAND MUST BE T'
         MEXIT
.CHECKRC AIF   ('&RCV' EQ '' OR '&RCV' EQ '(15)').CHECKN
         AIF   ('&RCV'(1,1) NE '(').CHECKN
         MNOTE 8,'RETURN: RC REGISTER MUST BE 15'
         MEXIT
.CHECKN  AIF   (N'&REGS LE 2).CHECKR
         MNOTE 8,'RETURN: REGISTER RANGE TOO LONG'
         MEXIT
.CHECKR  ANOP
&NAME    DS    0H
         AIF   (N'&REGS EQ 0).AFTER
         RDREGN &REGS(1)
&R1      SETA  &RDRV
&R2      SETA  &RDRV
         AIF   (N'&REGS LT 2).RANGE
         RDREGN &REGS(2)
&R2      SETA  &RDRV
.RANGE   AIF   (&R1 LT 0 OR &R2 LT 0).BADREG
&OFF     SETA  (&R1*4+20)-((&R1*4+20)/64)*64
&LOW     SETA  &OFF+4*(16-&R1)
&SKIP15  SETB  ('&RCV' EQ '(15)' AND (&R1 GT &R2 OR &R2 EQ 15))
         AIF   (&SKIP15).SPLIT
         AIF   (&R1 EQ &R2).ONE
         LM    &R1,&R2,&OFF.(13)
         AGO   .AFTER
.ONE     L     &R1,&OFF.(13)
         AGO   .AFTER
.SPLIT   AIF   (&R1 GE 15).LOW
         AIF   (&R1 EQ 14).HIGHL
         LM    &R1,14,&OFF.(13)
         AGO   .LOW
.HIGHL   L     14,12(13)
.LOW     AIF   (&R1 LE &R2).AFTER
         AIF   (&R2 EQ 0).LOWL
         LM    0,&R2,&LOW.(13)
         AGO   .AFTER
.LOWL    L     0,&LOW.(13)
.AFTER   AIF   ('&T' NE 'T').RCSET
         MVI   12(13),X'FF'
.RCSET   AIF   ('&RCV' EQ '' OR '&RCV' EQ '(15)').RET
         LA    15,&RCV
.RET     BR    14
         MEXIT
.BADREG  MNOTE 8,'RETURN: INVALID REGISTER'
         MEND
