         MACRO
&NAME    STORAGE &ACTION,&LENGTH=,&ADDR=,&SP=,&LOC=,&COND=NO,&BNDRY=
         LCLA  &FL
         AIF   ('&ACTION' EQ 'OBTAIN').HAVEACT
         AIF   ('&ACTION' EQ 'RELEASE').HAVEACT
         MNOTE 8,'STORAGE: FIRST OPERAND MUST BE OBTAIN OR RELEASE'
         MEXIT
.HAVEACT AIF   ('&COND' EQ 'NO').HAVEC
         AIF   ('&COND' EQ 'YES').CONDYES
         MNOTE 8,'STORAGE: COND MUST BE YES OR NO'
         MEXIT
.CONDYES ANOP
&FL      SETA  2
.HAVEC   AIF   ('&LENGTH' NE '').HAVELEN
         MNOTE 8,'STORAGE: LENGTH MISSING'
         MEXIT
.HAVELEN AIF   ('&ADDR' NE '').HAVEADR
         MNOTE 8,'STORAGE: ADDR MISSING'
         MEXIT
.HAVEADR AIF   ('&BNDRY' EQ '' OR '&BNDRY' EQ 'DBLWD').BOUND
         AIF   ('&BNDRY' EQ 'PAGE').PAGE
         MNOTE 8,'STORAGE: BNDRY MUST BE DBLWD OR PAGE'
         MEXIT
.PAGE    ANOP
&FL      SETA  &FL+4
.BOUND   ANOP
&NAME    DS    0H
         AIF   ('&ACTION' EQ 'RELEASE').RELEASE
         RDSTSVC &LENGTH,&SP,&FL
         AIF   ('&ADDR'(1,1) EQ '(').TOREG
         ST    1,&ADDR
         MEXIT
.TOREG   LR    &ADDR(1),1
         MEXIT
.RELEASE RDSTREG 1,&ADDR
&FL      SETA  &FL+1
         RDSTSVC &LENGTH,&SP,&FL
         MEND
