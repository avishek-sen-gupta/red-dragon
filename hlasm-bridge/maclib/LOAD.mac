         MACRO
&NAME    LOAD  &EP=,&EPLOC=,&ERRET=
         GBLB  &RDSTBAD
&NAME    DS    0H
         RDPGM LOAD,&EP,&EPLOC
         AIF   (&RDSTBAD).OUT
         LA    1,0
         AIF   ('&ERRET' NE '').ERRET
         SVC   8
         MEXIT
.ERRET   OILH  1,X'8000'
         SVC   8
         LTR   15,15
         BNZ   &ERRET
.OUT     MEND
